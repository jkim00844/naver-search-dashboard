# ==========================================
# 1. 보안 및 환경 변수 (Secrets & Environment)
# ==========================================
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ==========================================
# 2. 가상환경 및 패키지 매니저 (Virtual Environments)
# ==========================================
.venv/
venv/
env/
ENV/
.uv/

# ==========================================
# 3. 파이썬 바이트코드 및 캐시 (Python Cache)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ==========================================
# 4. 배포 및 패키징 아티팩트 (Build & Packaging)
# ==========================================
dist/
build/
*.egg-info/
*.egg

# ==========================================
# 5. OS 및 IDE 설정 파일 (OS & Editor Files)
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.idea/
.vscode/
*.swp
*.swo

# ==========================================
# 6. 로그 및 로컬 데이터 파일 (Logs & Output)
# ==========================================
*.log
output/
downloads/

